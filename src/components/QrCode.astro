---
import { qrPath } from '../lib/qr';

interface Props {
  url: string;
  caption: string;
}
const { url, caption } = Astro.props;
const { d, view } = qrPath(url);
---

<figure class="qr">
  <svg viewBox={`0 0 ${view} ${view}`} shape-rendering="crispEdges" role="img" aria-label={`QR code: ${caption}`}>
    <rect class="qr-paper" width={view} height={view} />
    <path class="qr-ink" d={d} />
  </svg>
  <figcaption class="dim">{caption}</figcaption>
</figure>
