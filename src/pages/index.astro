---
import '@fontsource/monaspace-neon/400.css';
import '@fontsource/monaspace-neon/700.css';
import '@fontsource/monaspace-radon/400.css';
import '../styles/global.css';
import Banner from '../components/Banner.astro';
import Glyph from '../components/Glyph.astro';
import QrCode from '../components/QrCode.astro';
import SemesterRead from '../components/SemesterRead.astro';
import { site } from '../data/site';
import { getSemesters } from '../lib/sessions';

const semesters = await getSemesters();
const [current, ...later] = semesters;
const next = semesters.flatMap((s) => s.sessions).find((s) => s.status === 'next');

const description =
  'AI Club (Algorithmic Problem Solving with AI) is a student club at HTL Leonding. We learn AI coding tools, practice, and swap tricks, settings and agent skills.';
const pitch = [
  'learn the AI coding tools that matter right now',
  'practice on real problems, hands on keyboards',
  "discuss what's new, and what's just hype",
  'swap what works: experiences, tricks, preferences, settings, agent skills',
];
const plan = [
  'Pick one topic, such as context management, tool calling or sandboxing',
  'Introduce it for beginners, as a recap for semi-pros',
  'Dive into specific details for pros',
  'Try it hands-on in an example',
];
const commands = [
  { cmd: '/join', desc: site.joinFormUrl ? 'open the sign-up form' : 'sign up (form link coming soon)' },
  { cmd: '/next', desc: 'show the next session' },
  { cmd: '/sessions', desc: 'show all sessions, winter and summer' },
  { cmd: '/guest', desc: 'register as an external guest' },
  { cmd: '/people', desc: 'show who runs the club' },
  { cmd: '/theme', desc: 'switch between dark and light' },
  { cmd: '/help', desc: 'list all commands' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI Club · HTL Leonding</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#131215" />
    <meta property="og:title" content="AI Club · Algorithmic Problem Solving with AI" />
    <meta property="og:description" content={description} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var t = localStorage.getItem('aiclub-theme');
          if (t === 'light' || t === 'dark') root.dataset.theme = t;
          if (t === 'light') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#fcfbfa');
        } catch (e) {}
        var replay = false;
        try {
          replay =
            !matchMedia('(prefers-reduced-motion: reduce)').matches &&
            !location.hash &&
            !sessionStorage.getItem('aiclub-replayed');
        } catch (e) {}
        if (replay) root.classList.add('replay');
        root.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#join">Skip to sign-up</a>

    <header class="topbar">
      <a class="topbar-home" href="#top" aria-label="AI Club, back to top">
        <Glyph name="mark" /><span>ai-club</span>
      </a>
      <span class="topbar-path dim" aria-hidden="true">{site.cwd}</span>
      <nav class="topbar-nav" aria-label="Quick actions">
        <button type="button" class="cmd-btn theme-toggle" data-theme-toggle>
          /theme <span class="theme-dot" aria-hidden="true"></span>
        </button>
        <a class="cmd-btn" href="#join">/join</a>
      </nav>
    </header>

    <main class="term" id="top">
      <section class="welcome" data-step aria-labelledby="club-name">
        <div class="welcome-main">
          <p class="welcome-title">
            <Glyph name="mark" />
            <span>Welcome to the <b>AI Club</b>!</span>
          </p>
          <h1 id="club-name" class="welcome-banner">
            <Banner />
          </h1>
          <p class="welcome-full">{site.fullName}</p>
          <p class="dim">
            A student club at <a href={site.schoolUrl}>{site.school}</a>
          </p>
          <p class="dim welcome-help">
            <button type="button" class="run" data-run="/join">/join</button> to sign up{' · '}<button type="button" class="run" data-run="/sessions">/sessions</button> for all dates{' · '}<button type="button" class="run" data-run="/help">/help</button> for more
          </p>
          <p class="dim welcome-cwd">cwd: {site.cwd}</p>
        </div>
        <div class="welcome-side">
          <div class="side-block">
            <h2 class="side-title">Next session</h2>
            {
              next ? (
                <p>
                  <a href={`#${next.id}`} data-next-link class="side-next">
                    <b>{next.shortDate} · {next.timeRange.split('–')[0]}</b>
                    <span>{next.title}</span>
                    <small>{next.place}</small>
                  </a>
                </p>
              ) : (
                <p class="dim">Dates for the next semester follow soon.</p>
              )
            }
          </div>
          <div class="side-block">
            <h2 class="side-title quiet">Tips for getting started</h2>
            <ol class="tips" role="list">
              <li><span class="tip-n">1.</span> Bring a laptop. No coding agent of your own? Use Novedu, the school's free one.</li>
              <li><span class="tip-n">2.</span> No experience needed. Curiosity is.</li>
              <li><span class="tip-n">3.</span> Most meetings are hybrid, so you can also join from home.</li>
            </ol>
          </div>
        </div>
      </section>

      <p class="user-prompt" data-step="type">
        <span class="prompt-sign" aria-hidden="true">&gt;</span>
        <span class="typed" data-typed>what is this club?</span>
      </p>

      <section class="msg" aria-label="What the club is">
        <Glyph name="dot" />
        <div class="msg-body prose">
          <p data-step>
            <b>AI Club</b>, officially <b>{site.fullName}</b>, is a student club at {site.school} for everyone
            who wants to get better at coding with AI.
          </p>
          <p data-step>Every few weeks we meet to:</p>
          <ul class="dash-list" role="list" data-step>
            {pitch.map((line) => <li>{line}</li>)}
          </ul>
          <p data-step>
            It's open to all students, and to external guests. Attend at least half of the sessions and your
            participation goes on your school report.
          </p>
        </div>
      </section>

      <section class="msg tool" aria-labelledby="plan-title" data-step>
        <Glyph name="dot" class="ok" />
        <div class="msg-body">
          <h2 class="tool-call" id="plan-title"><b>Update Todos</b></h2>
          <div class="result">
            <Glyph name="elbow" />
            <div class="result-body">
              <p class="dim result-line">How every session runs</p>
              <ol class="todos" role="list">
                {
                  plan.map((step) => (
                    <li>
                      <span class="check">
                        <Glyph name="todo" />
                      </span>
                      <span>{step}</span>
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>
        </div>
      </section>

      <div data-step>
        <SemesterRead semester={current} id="sessions" />
      </div>

      <template data-later>
        {later.map((s) => <SemesterRead semester={s} id={`sessions-${s.key}`} />)}
      </template>
      <noscript>
        {later.map((s) => <SemesterRead semester={s} id={`sessions-${s.key}`} />)}
      </noscript>

      <section class="permission" id="join" tabindex="-1" aria-labelledby="join-q" data-step>
        <div class="permission-main">
        <h2 id="join-q" class="permission-q">Join the AI Club?</h2>
        <p class="dim">
          {site.joinFormUrl ? 'Sign-up takes a minute, through a Microsoft Form.' : 'Sign-up runs through a Microsoft Form. The link is coming soon.'}
        </p>
        <ol class="options" role="list" data-options>
          <li>
            {
              site.joinFormUrl ? (
                <a class="opt" href={site.joinFormUrl} target="_blank" rel="noopener" data-opt="join">
                  <Glyph name="pointer" />
                  <span class="opt-n">1.</span>
                  <span>Yes, open the sign-up form</span>
                </a>
              ) : (
                <button type="button" class="opt" data-opt="join" data-unlinked>
                  <Glyph name="pointer" />
                  <span class="opt-n">1.</span>
                  <span>Yes, sign me up</span>
                </button>
              )
            }
          </li>
          <li data-opt-item="sessions">
            <button type="button" class="opt" data-opt="sessions">
              <Glyph name="pointer" />
              <span class="opt-n">2.</span>
              <span>Show me all sessions first</span>
            </button>
          </li>
          <li>
            <button type="button" class="opt" data-opt="guest">
              <Glyph name="pointer" />
              <span class="opt-n">3.</span>
              <span>I'm an external guest. How do I register?</span>
            </button>
          </li>
        </ol>
        <p class="dim keys kbd-hint"><span class="unit">↑↓ to move</span> · <span class="unit">enter to select</span> · <span class="unit">or press 1–3</span></p>
        </div>
        {site.joinFormUrl && <QrCode url={site.joinFormUrl} caption="scan to sign up" />}
      </section>
      <div class="log join-log" data-join-log aria-live="polite"></div>



      <section class="msg" aria-label="An example of what members take home" data-step>
        <Glyph name="dot" />
        <div class="msg-body prose">
          <p>A typical take-home: a rule another member already tested, now in your own agent setup.</p>
        </div>
      </section>

      <section class="msg tool" aria-label="Example change to an agent instruction file" data-step>
        <Glyph name="dot" class="ok" />
        <div class="msg-body">
          <h2 class="tool-call"><b>Update</b>(<span class="path">your-setup/<wbr />AGENTS.md</span>)</h2>
          <div class="result">
            <Glyph name="elbow" />
            <div class="result-body">
              <p class="dim result-line">
                Updated <b class="fg">your-setup/AGENTS.md</b> with <b class="fg">3</b> additions and <b class="fg">1</b> removal
              </p>
              <div class="diff" role="table" aria-label="Diff of AGENTS.md">
                <div class="diff-row ctx" role="row">
                  <span class="ln" role="cell">14</span><span class="sg" role="cell"></span><span class="code" role="cell">## How to work with me</span>
                </div>
                <div class="diff-row del" role="row">
                  <span class="ln" role="cell">15</span><span class="sg" role="cell" aria-label="removed">-</span><span class="code" role="cell">Just fix it.</span>
                </div>
                <div class="diff-row add" role="row">
                  <span class="ln" role="cell">15</span><span class="sg" role="cell" aria-label="added">+</span><span class="code" role="cell">Write a failing test first, then make it pass.</span>
                </div>
                <div class="diff-row add" role="row">
                  <span class="ln" role="cell">16</span><span class="sg" role="cell" aria-label="added">+</span><span class="code" role="cell">Explain your plan before you edit any file.</span>
                </div>
                <div class="diff-row add" role="row">
                  <span class="ln" role="cell">17</span><span class="sg" role="cell" aria-label="added">+</span><span class="code" role="cell">Keep each diff small enough to review in a minute.</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="msg tool" id="people" aria-label="Who runs the club" data-step>
        <Glyph name="dot" class="ok" />
        <div class="msg-body">
          <h2 class="tool-call"><b>Read</b>(<span class="path">CODEOWNERS</span>)</h2>
          <div class="result">
            <Glyph name="elbow" />
            <div class="result-body">
              <p class="dim result-line"># who runs the club</p>
              <dl class="owners">
                {
                  site.people.map((p) => (
                    <div class="owner">
                      <dt>
                        <span class="dim" aria-hidden="true">* </span>
                        {p.name}
                      </dt>
                      <dd class="dim"># {p.role}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>
        </div>
      </section>

      <div class="log" data-log aria-live="polite"></div>

      <form class="input" data-input autocomplete="off" data-step>
        <label class="sr-only" for="cmd">Type a command, for example /join</label>
        <div class="input-box">
          <span class="prompt-sign" aria-hidden="true">&gt;</span>
          <input
            id="cmd"
            name="cmd"
            type="text"
            spellcheck="false"
            autocapitalize="off"
            enterkeyhint="send"
            placeholder='Try "/join" or "/sessions"'
            role="combobox"
            aria-expanded="false"
            aria-controls="cmd-menu"
            aria-autocomplete="list"
          />
        </div>
        <ul class="menu" id="cmd-menu" role="listbox" aria-label="Commands" hidden>
          {
            commands.map((c, i) => (
              <li role="option" id={`cmd-opt-${i}`} data-cmd={c.cmd} aria-selected="false">
                <span class="menu-cmd">{c.cmd}</span>
                <span class="menu-desc dim">{c.desc}</span>
              </li>
            ))
          }
        </ul>
        <div class="statusline dim">
          <span><span class="kbd-hint"><span class="unit">? for shortcuts</span> · </span><span class="unit">guests welcome</span></span>
          <button type="button" class="cmd-btn quiet" data-theme-toggle>
            <span class="theme-dot" aria-hidden="true"></span><span class="theme-name">dark</span>
          </button>
        </div>
      </form>

      <footer class="foot dim">
        <p>AI Club · {site.fullName} · <a href={site.schoolUrl}>{site.school}</a></p>
        <p>The look is a nod to terminal coding agents. Not affiliated with any AI vendor.</p>
      </footer>
    </main>

    <script>
      import '../scripts/terminal';
    </script>
    <script is:inline type="application/json" id="aiclub-data" set:html={JSON.stringify({ joinFormUrl: site.joinFormUrl, guestFormUrl: site.guestFormUrl, people: site.people })} />
  </body>
</html>
